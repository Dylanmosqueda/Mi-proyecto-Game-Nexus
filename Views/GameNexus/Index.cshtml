@model List<Game_Nexus.Models.Item>

<!-- Fuentes: Estilo industrial y desgastado -->
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Orbitron:wght@700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">

<style>
    /* --- ATMÓSFERA TÓXICA DE SCARECROW --- */
    body {
        background-color: #050400 !important;
        color: #d4a373;
        font-family: 'Rajdhani', sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        /* Efecto de grano de película y gas */
        background-image: radial-gradient(circle at center, rgba(163, 64, 0, 0.15) 0%, transparent 70%), url('https://www.transparenttextures.com/patterns/asfalt-dark.png');
    }

    /* Animación de Parpadeo de Gas del Miedo */
    @@keyframes fearPulse {
        0%, 100% {
            opacity: 0.8;
            filter: saturate(1) contrast(1.2);
        }

        50% {
            opacity: 1;
            filter: saturate(2) contrast(1.5) drop-shadow(0 0 10px #ff4500);
        }
    }

    @@keyframes glitchEffect {
        0% {
            transform: translate(0);
        }

        20% {
            transform: translate(-3px, 2px);
            clip-path: inset(10% 0 30% 0);
        }

        40% {
            transform: translate(3px, -2px);
            clip-path: inset(30% 0 10% 0);
        }

        100% {
            transform: translate(0);
        }
    }

    /* --- CABECERA: TRANSMISIÓN HACKEADA --- */
    .scarecrow-header {
        position: relative;
        height: 350px;
        background: linear-gradient(to bottom, #1a0f00, #050400);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-bottom: 2px solid #8b0000;
        box-shadow: 0 0 50px rgba(139, 0, 0, 0.4);
        overflow: hidden;
    }

        .scarecrow-header::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255, 69, 0, 0.05) 3px);
            pointer-events: none;
        }

    .scarecrow-title {
        font-family: 'Orbitron', sans-serif;
        color: #ff4500;
        font-size: 4rem;
        font-weight: 900;
        letter-spacing: 15px;
        text-shadow: 5px 5px 0px #3a0000;
        margin: 0;
        animation: glitchEffect 2s infinite alternate-reverse;
    }

    .fear-subtitle {
        font-family: 'Special Elite', cursive;
        color: #ffcc00;
        letter-spacing: 5px;
        font-size: 1.2rem;
        margin-top: 10px;
        text-transform: uppercase;
    }

    /* --- TARJETAS: EXPEDIENTES TÓXICOS --- */
    .fear-card {
        background: rgba(20, 15, 10, 0.95);
        border: 1px solid #4a2c00;
        margin-bottom: 40px;
        position: relative;
        transition: 0.3s;
        /* Estilo más tosco y asimétrico */
        clip-path: polygon(2% 0%, 100% 0%, 98% 100%, 0% 100%);
    }

        .fear-card:hover {
            transform: scale(1.02) rotate(1deg);
            border-color: #ff4500;
            box-shadow: 0 0 30px rgba(255, 69, 0, 0.3);
        }

    .card-header-fear {
        background: #2a1b0a;
        padding: 10px 20px;
        border-bottom: 2px solid #ff4500;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .fear-tag {
        font-family: 'Special Elite', cursive;
        font-size: 0.7rem;
        color: #ff4500;
    }

    .game-image-container {
        filter: sepia(100%) saturate(150%) brightness(0.6) contrast(1.2);
        transition: 0.5s;
        border: 2px solid #1a1a1a;
        margin: 10px;
    }

    .fear-card:hover .game-image-container {
        filter: sepia(50%) saturate(200%) brightness(0.8);
    }

    .data-label {
        font-family: 'Special Elite', cursive;
        font-size: 0.65rem;
        color: #ffcc00;
        text-transform: uppercase;
    }

    .data-text {
        color: #e0ccb1;
        font-weight: bold;
        letter-spacing: 1px;
    }

    /* Botones Estilo "Inyectora" */
    .btn-toxin {
        display: block;
        background: #4a0000;
        color: #ff4500;
        border: 1px solid #ff4500;
        padding: 10px;
        text-align: center;
        text-decoration: none;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.8rem;
        transition: 0.3s;
        margin-top: 15px;
    }

        .btn-toxin:hover {
            background: #ff4500;
            color: #000;
            box-shadow: 0 0 20px #ff4500;
        }

    .btn-add-fear {
        background: #ff4500;
        color: #000;
        padding: 20px 50px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        text-decoration: none;
        border: none;
        clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
        transition: 0.4s;
    }

        .btn-add-fear:hover {
            background: #ffcc00;
            letter-spacing: 5px;
            box-shadow: 0 0 40px #ffcc00;
        }

    /* Filtros estilo terminal hackeada */
    .fear-filter {
        color: #ffcc00;
        text-decoration: none;
        font-family: 'Special Elite', cursive;
        margin: 0 10px;
        padding: 5px 10px;
        border: 1px solid transparent;
    }

        .fear-filter:hover {
            border: 1px solid #ff4500;
            color: #ff4500;
            background: rgba(255, 69, 0, 0.1);
        }

</style>

<!-- HEADER SCARECROW -->
<div class="scarecrow-header">
    <h1 class="scarecrow-title">GAME NEXUS HUB</h1>
    <p class="fear-subtitle">Transmisión Iniciada: Protocolo Archivos del Miedo </p>
    <div style="width: 100%; height: 2px; background: #ff4500; position: absolute; bottom: 10px; animation: fearPulse 1s infinite;"></div>
</div>

<div class="container mt-5">
    <!-- FILTROS -->
    <div class="text-center mb-5">
        <h3 style="font-family: 'Special Elite'; color: #8b0000;">SELECCIONAR ARCHIVO INFECTADO:</h3>
        <div class="mt-4">
            <a asp-action="Index" class="fear-filter">TODOS LOS ARCHIVOS</a>
            @foreach (var gen in ViewBag.Generos as List<string>)
            {
                <a asp-action="Index" asp-route-genero="@gen" class="fear-filter">@gen.ToUpper()</a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="fear-card">
                    <div class="card-header-fear">
                        <span class="fear-tag">ARCHIVO DE PRUEBA // @item.Id</span>
                        <div style="width: 8px; height: 8px; background: #ff4500; border-radius: 50%; animation: fearPulse 0.5s infinite;"></div>
                    </div>

                    <div class="p-4">
                        <h4 class="text-center" style="font-family: 'Orbitron'; color: #ffcc00; text-transform: uppercase;">@item.Titulo</h4>

                        <div class="game-image-container">
                            <img src="@item.ImagenUrl" style="width: 100%; height: 200px; object-fit: cover;" />
                        </div>

                        <div class="mt-4">
                            <div class="row">
                                <div class="col-6 mb-2">
                                    <span class="data-label">ORIGEN:</span><br />
                                    <span class="data-text">@item.Desarrollador</span>
                                </div>
                                <div class="col-6 mb-2">
                                    <span class="data-label">ESTADO DEL ARCHIVO:</span><br />
                                    <span class="data-text" style="color: #ff4500;">@item.EstadoProgreso</span>
                                </div>
                                <div class="col-6">
                                    <span class="data-label">PLATAFORMA:</span><br />
                                    <span class="data-text">@item.Consola</span>
                                </div>
                                <div class="col-6">
                                    <span class="data-label">NIVEL DE MIEDO:</span><br />
                                    <span class="data-text" style="color: #ffcc00;">@item.Calificacion / 10</span>
                                </div>
                            </div>
                        </div>

                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn-toxin">
                             DETALLES DEL ARCHIVO
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- BOTÓN AGREGAR -->
    <div class="text-center mt-5 mb-5 pb-5">
        <a asp-action="Agregar" class="btn-add-fear">
            + AÑADIR NUEVO ARCHIVO
        </a>
    </div>
</div>