@model List<Game_Nexus.Models.Item>

<!-- Nuevas Fuentes de Google estilo Halo/UNSC (Michroma y Exo 2) -->
<link href="https://fonts.googleapis.com/css2?family=Michroma&family=Exo+2:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
    /* --- CONFIGURACIÓN GLOBAL --- */
    body {
        background-color: #000b14 !important;
        color: #b3e5ff;
        /* Fuente principal de lectura cambiada a Exo 2 */
        font-family: 'Exo 2', sans-serif;
        margin: 0;
        padding: 0;
        background-image: linear-gradient(rgba(0, 242, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 242, 255, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    /* --- ANIMACIÓN DE CABECERA --- */
    .ai-interface-header {
        position: relative;
        height: 350px;
        background: radial-gradient(circle at center, #001a2e 0%, #00050a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-bottom: 2px solid #00f2ff;
        box-shadow: 0 5px 25px rgba(0, 242, 255, 0.2);
    }

    .ai-visuals {
        position: absolute;
        width: 350px;
        height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.6;
    }

    .ring {
        position: absolute;
        border-radius: 50%;
        border: 2px solid rgba(0, 242, 255, 0.3);
    }

    .outer-ring {
        width: 300px;
        height: 300px;
        border-style: dashed;
        animation: rotateCW 20s linear infinite;
    }

    .middle-ring {
        width: 230px;
        height: 230px;
        border: 1px solid rgba(0, 242, 255, 0.5);
        border-top-color: transparent;
        border-bottom-color: transparent;
        animation: rotateCCW 12s linear infinite;
    }

    .inner-ring {
        width: 170px;
        height: 170px;
        border: 3px double #00f2ff;
        border-left-color: transparent;
        border-right-color: transparent;
        animation: rotateCW 6s linear infinite;
    }

    .core-pulse {
        width: 90px;
        height: 90px;
        background: radial-gradient(circle, rgba(0, 242, 255, 0.9) 0%, transparent 70%);
        border-radius: 50%;
        box-shadow: 0 0 40px #00f2ff;
        animation: corePulse 2s ease-in-out infinite alternate;
    }

    .header-content {
        z-index: 10;
        text-align: center;
    }

    .unsc-title-main {
        /* Cambio a Michroma */
        font-family: 'Michroma', sans-serif;
        color: #00f2ff;
        font-size: 3rem;
        letter-spacing: 12px;
        text-shadow: 0 0 20px rgba(0, 242, 255, 0.8);
        margin: 0;
    }

    /* --- TARJETAS TÁCTICAS --- */
    .unsc-card {
        background: rgba(0, 20, 40, 0.7);
        border: 1px solid #00f2ff;
        margin-bottom: 30px;
        transition: 0.4s;
        clip-path: polygon(0 20px, 20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%);
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(5px);
    }

        .unsc-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 0 30px rgba(0, 242, 255, 0.4);
            background: rgba(0, 40, 80, 0.8);
        }

    .card-header-unsc {
        border-bottom: 1px solid rgba(0, 242, 255, 0.3);
        padding: 15px;
        background: rgba(0, 242, 255, 0.1);
    }

    .label-tag {
        /* Michroma para etiquetas pequeñas */
        font-family: 'Michroma', sans-serif;
        font-size: 0.55rem;
        color: #00f2ff;
        text-transform: uppercase;
        font-weight: bold;
        letter-spacing: 1.5px;
    }

    .data-value {
        color: #fff;
        font-size: 0.95rem;
        font-weight: 400;
    }

    .scanline {
        position: absolute;
        width: 100%;
        height: 5px;
        background: rgba(0, 242, 255, 0.2);
        box-shadow: 0 0 10px #00f2ff;
        animation: scanAnim 4s linear infinite;
        pointer-events: none;
    }

    /* Botones */
    .btn-unsc {
        display: inline-block;
        border: 1px solid #00f2ff;
        color: #00f2ff;
        padding: 10px 20px;
        text-decoration: none;
        /* Michroma para botones */
        font-family: 'Michroma', sans-serif;
        font-size: 0.7rem;
        text-align: center;
        transition: 0.3s;
        background: rgba(0, 242, 255, 0.05);
        letter-spacing: 1px;
    }

        .btn-unsc:hover {
            background: #00f2ff;
            color: #000;
            box-shadow: 0 0 15px #00f2ff;
        }

    /* --- ANIMACIONES --- */
    @@keyframes rotateCW {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes rotateCCW {
        from {
            transform: rotate(360deg);
        }

        to {
            transform: rotate(0deg);
        }
    }

    @@keyframes corePulse {
        0% {
            transform: scale(0.8);
            opacity: 0.5;
        }

        100% {
            transform: scale(1.1);
            opacity: 1;
        }
    }

    @@keyframes scanAnim {
        0% {
            top: -10%;
        }

        100% {
            top: 110%;
        }
    }

</style>

<!-- HEADER ANIMADO -->
<div class="ai-interface-header">
    <div class="ai-visuals">
        <div class="ring outer-ring"></div>
        <div class="ring middle-ring"></div>
        <div class="ring inner-ring"></div>
        <div class="core-pulse"></div>
    </div>
    <div class="header-content">
        <h1 class="unsc-title-main">GAME NEXUS HUB</h1>
        <p style="color: #89e2ff; letter-spacing: 5px; font-weight: 300; margin-top: 10px; font-size: 0.8rem;">
            [ ESTADO DEL SISTEMA: EN LINEA // AI: CORTANA_4.0 ]
        </p>
    </div>
</div>

<div class="container mt-5">
    <!-- SECCIÓN DE FILTROS -->
    <div class="text-center mb-5">
        <h3 style="font-family: 'Michroma', sans-serif; color: #00f2ff; letter-spacing: 3px; font-size: 1.2rem;">CATÁLOGO DE VIDEOJUEGOS</h3>
        <div class="mt-4">
            <a asp-action="Index" class="btn-unsc mx-1">TODOS LOS ARCHIVOS</a>
            @foreach (var gen in ViewBag.Generos as List<string>)
            {
                <a asp-action="Index" asp-route-genero="@gen" class="btn-unsc mx-1" style="font-size: 0.6rem; border-color: rgba(0,242,255,0.3);">@gen</a>
            }
        </div>
    </div>

    <!-- LISTA DE VIDEOJUEGOS -->
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="unsc-card">
                    <div class="scanline"></div>

                    <div class="card-header-unsc">
                        <h4 class="m-0 text-white" style="font-family: 'Michroma', sans-serif; font-size: 1rem; letter-spacing: 1px;">@item.Titulo</h4>
                    </div>

                    <div class="p-4">
                        <img src="@item.ImagenUrl" style="width: 100%; height: 180px; object-fit: cover; border: 1px solid rgba(0,242,255,0.3); filter: brightness(0.9) contrast(1.1);" />

                        <div class="mt-3">
                            <div class="row">
                                <div class="col-6 mb-2">
                                    <span class="label-tag">Desarrollado por:</span><br />
                                    <span class="data-value">@item.Desarrollador</span>
                                </div>
                                <div class="col-6 mb-2">
                                    <span class="label-tag">Estado</span><br />
                                    <span class="data-value" style="color: #00f2ff;">@item.EstadoProgreso</span>
                                </div>
                                <div class="col-6 mb-2">
                                    <span class="label-tag">Plataforma</span><br />
                                    <span class="data-value">@item.Consola</span>
                                </div>
                                <div class="col-6 mb-2">
                                    <span class="label-tag">Calificación</span><br />
                                    <span class="data-value" style="color: #ffcc00; font-family: 'Michroma'; font-size: 0.7rem;">@item.Calificacion / 10</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <a asp-action="Detalle" asp-route-id="@item.Id" class="btn-unsc w-100">
                                ACCESO A LA CARPETA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- BOTÓN AGREGAR -->
    <div class="text-center mt-5 mb-5 pb-5">
        <a asp-action="Agregar" class="btn-unsc" style="padding: 15px 40px; font-size: 1rem; background: rgba(0,242,255,0.1); border-width: 2px;">
            + NUEVO VIDEOJUEGO
        </a>
    </div>
</div>