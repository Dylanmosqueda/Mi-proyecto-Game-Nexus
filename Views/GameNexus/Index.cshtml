@model List<Game_Nexus.Models.Item>

<!-- Fuentes: Estilo industrial y desgastado -->
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Orbitron:wght@700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">

<style>
    /* --- ATMÓSFERA DE PESADILLA POTENCIADA --- */
    body {
        background-color: #020200 !important;
        color: #bc8f8f;
        font-family: 'Rajdhani', sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        /* Fondo con rejilla de energía naranja muy tenue */
        background-image: radial-gradient(circle at center, rgba(139, 0, 0, 0.2) 0%, #000 100%), linear-gradient(rgba(255, 69, 0, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 69, 0, 0.05) 1px, transparent 1px);
        background-size: 100% 100%, 30px 30px, 30px 30px;
    }

        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            box-shadow: inset 0 0 200px #000, inset 0 0 100px rgba(255, 69, 0, 0.2);
            pointer-events: none;
            z-index: 9999;
        }

    /* --- ANIMACIONES LLAMATIVAS --- */
    @@keyframes chromaticAberration {
        0% {
            text-shadow: 2px 2px #ff4500, -2px -2px #ff0000;
        }

        50% {
            text-shadow: -2px 2px #ffcc00, 2px -2px #ff4500;
            transform: scale(1.01);
        }

        100% {
            text-shadow: 2px 2px #ff4500, -2px -2px #ff0000;
        }
    }

    @@keyframes cardGlow {
        0%, 100% {
            border-color: #300000;
            box-shadow: 0 0 10px rgba(139, 0, 0, 0.2);
        }

        50% {
            border-color: #ff4500;
            box-shadow: 0 0 25px rgba(255, 69, 0, 0.4);
        }
    }

    /* --- CABECERA --- */
    .scarecrow-header {
        position: relative;
        height: 380px;
        background: #000;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-bottom: 4px solid #ff4500;
        box-shadow: 0 0 50px rgba(255, 69, 0, 0.5);
        overflow: hidden;
    }

    .scarecrow-title {
        font-family: 'Orbitron', sans-serif;
        color: #fff;
        font-size: 5rem;
        font-weight: 900;
        letter-spacing: 15px;
        margin: 0;
        animation: chromaticAberration 0.2s infinite; /* Glitch de color constante */
        text-transform: uppercase;
    }

    .fear-subtitle {
        font-family: 'Special Elite', cursive;
        color: #ffcc00;
        letter-spacing: 8px;
        font-size: 1.5rem;
        margin-top: 15px;
        text-shadow: 0 0 10px #ffcc00;
    }

    /* --- TARJETAS EXPEDIENTES --- */
    .fear-card {
        background: rgba(10, 5, 0, 0.98);
        border: 2px solid #300000;
        margin-bottom: 50px;
        position: relative;
        transition: 0.2s;
        clip-path: polygon(0 5%, 100% 0, 95% 95%, 5% 100%);
        animation: cardGlow 3s infinite;
    }

        .fear-card:hover {
            transform: scale(1.05) translateY(-10px);
            border-color: #ffcc00;
            box-shadow: 0 0 50px #ff4500;
            z-index: 100;
            filter: brightness(1.2);
        }

    .card-header-fear {
        background: #1a0000;
        padding: 15px;
        border-bottom: 2px solid #ff4500;
        display: flex;
        justify-content: space-between;
    }

    .fear-tag {
        font-family: 'Special Elite', cursive;
        color: #ffcc00;
        font-weight: bold;
    }

    .game-image-container {
        filter: sepia(100%) contrast(1.5) brightness(0.6);
        border: 1px solid #4a0000;
        margin: 15px;
        overflow: hidden;
        transition: 0.3s;
        position: relative;
    }

        /* Línea de escaneo neón sobre la imagen */
        .game-image-container::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: #ff4500;
            box-shadow: 0 0 15px #ff4500;
            animation: scanline 2s linear infinite;
        }

    @@keyframes scanline {
        0% {
            top: 0%;
        }

        100% {
            top: 100%;
        }
    }

    .fear-card:hover .game-image-container {
        filter: sepia(0%) contrast(1.1) brightness(1);
    }

    .data-text {
        color: #fff;
        font-weight: 700;
        text-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
    }

    /* BOTONES NEÓN */
    .btn-toxin {
        display: block;
        background: #2a0000;
        color: #ff4500;
        border: 2px solid #ff4500;
        padding: 15px;
        text-align: center;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 3px;
        box-shadow: 0 0 15px #4a0000;
        transition: 0.3s;
        clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
    }

        .btn-toxin:hover {
            background: #ff4500;
            color: #000;
            box-shadow: 0 0 40px #ff4500;
            transform: skewX(-5deg);
        }

    .btn-add-fear {
        background: #ff4500;
        color: #000;
        padding: 25px 60px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1.5rem;
        text-decoration: none !important;
        box-shadow: 0 0 40px #ff4500;
        clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
        transition: 0.3s;
    }

        .btn-add-fear:hover {
            background: #fff;
            box-shadow: 0 0 80px #fff;
            letter-spacing: 5px;
        }

    .fear-filter {
        color: #ffcc00;
        font-family: 'Special Elite', cursive;
        margin: 0 15px;
        font-size: 1.1rem;
        text-shadow: 0 0 5px #ff4500;
        transition: 0.2s;
    }

        .fear-filter:hover {
            color: #fff;
            text-shadow: 0 0 20px #fff;
        }

    .static-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('https://media.giphy.com/media/oEI9uWUqnW3Fe/giphy.gif');
        opacity: 0.05;
        pointer-events: none;
        z-index: 1000;
        mix-blend-mode: overlay;
    }
</style>

<div class="static-overlay"></div>

<div class="scarecrow-header">
    <h1 class="scarecrow-title">GAME NEXUS HUB</h1>
    <p class="fear-subtitle">Ríndete... el miedo es tu nueva realidad</p>
    <div style="width: 100%; height: 4px; background: #ff4500; position: absolute; bottom: 0; box-shadow: 0 0 30px #ff4500;"></div>
</div>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h3 style="font-family: 'Special Elite'; color: #ff4500; text-shadow: 0 0 10px #8b0000;">FILTRAR EXPEDIENTES:</h3>
        <div class="mt-4">
            <a asp-action="Index" class="fear-filter">[ TODOS_LOS_EXPEDIENTES ]</a>
            @foreach (var gen in ViewBag.Generos as List<string>)
            {
                <a asp-action="Index" asp-route-genero="@gen" class="fear-filter">@gen.ToUpper()</a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="fear-card">
                    <div class="card-header-fear">
                        <span class="fear-tag">SUJETO_@item.Id</span>
                        <div style="width: 12px; height: 12px; background: #ff0000; border-radius: 50%; box-shadow: 0 0 10px #ff0000; animation: scanline 0.5s infinite;"></div>
                    </div>

                    <div class="p-4">
                        <h4 class="text-center" style="font-family: 'Orbitron'; color: #ffcc00; text-shadow: 0 0 10px rgba(255, 69, 0, 0.5);">@item.Titulo</h4>

                        <div class="game-image-container">
                            <img src="@item.ImagenUrl" style="width: 100%; height: 220px; object-fit: cover;" />
                        </div>

                        <div class="mt-4">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <span class="data-label">ORIGEN:</span><br />
                                    <span class="data-text">@item.Desarrollador</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <span class="data-label">ESTADO:</span><br />
                                    <span class="data-text" style="color: #ff4500;">@item.Estado</span>
                                </div>
                                <div class="col-6">
                                    <span class="data-label">TERMINAL:</span><br />
                                    <span class="data-text">@item.Consola</span>
                                </div>
                                <div class="col-6">
                                    <span class="data-label">PUNTUACION:</span><br />
                                    <span class="data-text" style="color: #ffcc00;">@item.Calificacion / 10</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <a asp-action="Detalle" asp-route-id="@item.Id" class="btn-toxin">
                                ANALIZAR EXPEDIENTE
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5 mb-5 pb-5">
        <a asp-action="Agregar" class="btn-add-fear">
            + NUEVO EXPEDIENTE
        </a>
    </div>
</div>

<script>
    // Pequeños flashes de inversión de color aleatorios (Llamativo y terrorífico)
    setInterval(() => {
        if(Math.random() > 0.96) {
            document.body.style.filter = "invert(1) contrast(5) hue-rotate(90deg)";
            setTimeout(() => {
                document.body.style.filter = "none";
            }, 70);
        }
    }, 1500);
</script>