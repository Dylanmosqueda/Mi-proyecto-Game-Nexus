@model Game_Nexus.Models.Item

<!-- Fuentes: Special Elite para informes médicos y Orbitron para la tecnología hackeada -->
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Orbitron:wght@700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">

<style>
    /* --- ATMÓSFERA DE PESADILLA PURA --- */
    body {
        background-color: #020200 !important;
        color: #bc8f8f;
        font-family: 'Rajdhani', sans-serif;
        margin: 0;
        overflow-x: hidden;
        /* Grano de película sucio y atmósfera de gas denso */
        background-image: radial-gradient(circle at center, rgba(74, 0, 0, 0.2) 0%, #000 100%), url('https://www.transparenttextures.com/patterns/carbon-fibre.png');
    }

        /* Viñeta claustrofóbica para cerrar el campo de visión */
        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            box-shadow: inset 0 0 200px #000, inset 0 0 100px rgba(0,0,0,1);
            pointer-events: none;
            z-index: 9999;
        }

    /* --- ANIMACIONES TERRORÍFICAS --- */

    /* Glitch Violento con inversión de color */
    @@keyframes violentHijack {
        0% {
            opacity: 0;
            transform: scale(1.1) skewX(10deg);
            filter: invert(1) contrast(5) blur(10px);
        }

        5% {
            opacity: 1;
            transform: scale(1) skewX(-10deg);
            filter: invert(0) blur(0);
        }

        10% {
            transform: translateX(-10px) rotate(1deg);
            filter: hue-rotate(90deg);
        }

        15% {
            transform: translateX(10px) rotate(-1deg);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Vibración de Nervios (Jitter) */
    @@keyframes jitter {
        0% {
            transform: translate(0);
        }

        25% {
            transform: translate(1px, -1px);
            filter: blur(0.5px);
        }

        50% {
            transform: translate(-1px, 1px);
        }

        75% {
            transform: translate(1px, 1px);
            filter: blur(0.5px);
        }

        100% {
            transform: translate(0);
        }
    }

    /* Pulso de Toxina (Aberración Cromática) */
    @@keyframes chromatic {
        0%, 100% {
            text-shadow: 2px 2px #300000;
        }

        50% {
            text-shadow: -3px 0 #ff0000, 3px 0 #00ff00;
            transform: scale(1.01);
        }
    }

    /* --- CONTENEDOR: EXPEDIENTE DE SUPLICIO --- */
    .fear-dossier {
        max-width: 1100px;
        margin: 50px auto;
        padding: 50px;
        background: rgba(10, 5, 0, 0.98);
        border: 2px solid #300000;
        border-top: 10px solid #ff4500;
        position: relative;
        /* Forma rota y asimétrica */
        clip-path: polygon(0 5%, 100% 0, 95% 95%, 5% 100%);
        box-shadow: 0 0 100px rgba(139, 0, 0, 0.4);
        animation: violentHijack 0.8s ease-in-out forwards;
    }

    /* CABECERA HACKEADA */
    .dossier-header {
        border-bottom: 3px double #ff4500;
        padding-bottom: 20px;
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .dossier-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 3rem;
        color: #ff4500;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 10px;
        animation: chromatic 3s infinite;
    }

    /* IMAGEN TÓXICA (MODO PESADILLA) */
    .img-toxin-container {
        position: relative;
        overflow: hidden;
        border: 3px solid #4a0000;
        animation: jitter 0.2s infinite;
    }

    .img-toxin {
        width: 100%;
        /* Efecto de cámara de tortura/seguridad */
        filter: sepia(1) contrast(2) brightness(0.5) grayscale(0.5);
        transition: 0.2s;
    }

    .img-toxin-container:hover .img-toxin {
        filter: sepia(0.5) contrast(1.5) brightness(0.8) hue-rotate(180deg);
        transform: scale(1.1);
    }

    /* SECCIONES DE DATOS */
    .data-item-fear {
        background: rgba(40, 0, 0, 0.3);
        padding: 20px;
        border-left: 5px solid #ff4500;
        margin-bottom: 20px;
        transition: 0.1s;
    }

        .data-item-fear:hover {
            background: #ff4500;
            color: #000;
            transform: translateX(15px) skewX(-5deg);
        }

            .data-item-fear:hover .label-fear, .data-item-fear:hover .value-fear {
                color: #000 !important;
            }

    .label-fear {
        font-family: 'Special Elite', cursive;
        font-size: 0.8rem;
        color: #ffcc00;
        text-transform: uppercase;
        display: block;
    }

    .value-fear {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.4rem;
        color: #fff;
        font-weight: 900;
    }

    /* CUADRO DE EVALUACIÓN (REPORT) */
    .toxin-report-box {
        margin-top: 30px;
        padding: 40px;
        background: rgba(0, 0, 0, 0.8);
        border: 1px solid #ff4500;
        position: relative;
        box-shadow: inset 0 0 30px rgba(255, 69, 0, 0.2);
    }

        .toxin-report-box::before {
            content:"EXPEDIENTE_DE_VÍCTIMA"; 
            position: absolute;
            top: -15px;
            left: 30px;
            background: #ff4500;
            color: #000;
            padding: 2px 20px;
            font-family: 'Orbitron';
            font-size: 0.7rem;
            font-weight: 900;
        }

    .report-text {
        margin: 0;
        line-height: 2;
        color: #d4a373;
        font-family: 'Special Elite', cursive;
        font-size: 1.1rem;
        filter: blur(0.4px); /* Simula mareo visual */
    }

    /* BOTONES */
    .btn-toxin-nav {
        display: inline-block;
        padding: 15px 45px;
        background: #4a0000;
        color: #ff4500;
        border: 2px solid #ff4500;
        text-decoration: none !important;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1rem;
        letter-spacing: 5px;
        transition: 0.2s;
        clip-path: polygon(15% 0, 100% 0, 85% 100%, 0 100%);
        animation: jitter 5s infinite;
    }

        .btn-toxin-nav:hover {
            background: #ff4500;
            color: #000;
            box-shadow: 0 0 50px #ff4500;
            transform: scale(1.1);
        }

    /* ESTÁTICA DE TV */
    .static-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('https://media.giphy.com/media/oEI9uWUqnW3Fe/giphy.gif');
        opacity: 0.05;
        pointer-events: none;
        z-index: 50;
        mix-blend-mode: overlay;
    }
</style>

<div class="fear-dossier">
    <div class="static-overlay"></div>

    <div class="row">
        <!-- COLUMNA IMAGEN (VÍCTIMA) -->
        <div class="col-md-5 text-center mb-5">
            <div class="img-toxin-container">
                <img src="@Model.ImagenUrl" class="img-toxin" alt="@Model.Titulo" />
            </div>
            <div style="margin-top: 20px; font-family: 'Special Elite'; color: #ff0000; font-size: 0.9rem; animation: jitter 0.1s infinite;">
                SUJETO BAJO OBSERVACIÓN // NO HAY RETORNO
            </div>
        </div>

        <!-- COLUMNA DATOS (HISTORIAL DE TRAUMA) -->
        <div class="col-md-7">
            <div class="dossier-header">
                <h1 class="dossier-title">@Model.Titulo</h1>
                <span style="font-family: 'Special Elite'; color: #ffcc00; font-size: 1rem;">SUJETO_#@Model.Id</span>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="data-item-fear">
                        <span class="label-fear">COMIENZO DE LA PESADILLA</span>
                        <span class="value-fear">@Model.Ano</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="data-item-fear">
                        <span class="label-fear">TIEMPO DE JUEGO</span>
                        <span class="value-fear">@Model.HorasDedicadas H.</span>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="data-item-fear">
                        <span class="label-fear">EXPEDIENTE CREADO</span>
                        <span class="value-fear">@Model.FechaAdquisicion.ToString("dd / MM / yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="toxin-report-box">
                <p class="report-text">
                    @Model.Descripcion
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model.VinculacionProyecto))
            {
                <div class="data-item-fear mt-4" style="border-left-color: #ff0000;">
                    <span class="label-fear"> VINCULACIÓN</span>
                    <span class="value-fear" style="font-size: 1.1rem; color: #ff4500;">@Model.VinculacionProyecto</span>
                </div>
            }
        </div>
    </div>

    <!-- BOTONES DE ACCIÓN -->
    <div style="display: flex; justify-content: center; border-top: 2px solid #4a0000; margin-top: 40px; padding-top: 30px;">
        <a asp-action="Index" class="btn-toxin-nav">
            ABANDONAR EXPEDIENTE
        </a>
    </div>
</div>

<script>
    // Script de alucinación visual (Flashes de inversión)
    setInterval(() => {
        if(Math.random() > 0.94) {
            document.body.style.filter = "invert(1) contrast(5) hue-rotate(90deg)";
            setTimeout(() => {
                document.body.style.filter = "none";
            }, 60);
        }
    }, 1200);
</script>