@model Game_Nexus.Models.Item

<!-- Fuentes Tácticas UNSC -->
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">

<style>
    /* --- ATMÓSFERA HUD SPARTAN MARK V --- */
    body {
        background-color: #070a0e !important;
        color: #e2f1f8;
        font-family: 'Rajdhani', sans-serif;
        margin: 0;
        overflow-x: hidden;
        /* Fondo con rejilla militar y brillo neón cian */
        background-image: radial-gradient(circle at center, rgba(0, 240, 255, 0.08) 0%, #05080c 100%), linear-gradient(rgba(0, 240, 255, 0.03) 50%, rgba(0, 0, 0, 0.4) 50%);
        background-size: 100% 100%, 100% 4px;
    }

        /* Viñeta de Visor Táctico Spartan */
        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            box-shadow: inset 0 0 150px #000, inset 0 0 80px rgba(0, 240, 255, 0.15);
            pointer-events: none;
            z-index: 9999;
        }

    /* --- ANIMACIONES DE SISTEMA HUD --- */

    /* Inicialización de Casco Spartan */
    @@keyframes spartanBoot {
        0% {
            opacity: 0;
            transform: scale(0.96) translateY(15px);
            filter: brightness(2) blur(8px);
        }

        15% {
            opacity: 1;
            filter: hue-rotate(90deg) blur(0);
        }

        100% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    /* Pulso Telemétrico del Visor */
    @@keyframes hudPulse {
        0%, 100% {
            border-color: #00f0ff;
            box-shadow: 0 0 35px rgba(0, 240, 255, 0.3);
        }

        50% {
            border-color: #ffb400;
            box-shadow: 0 0 50px rgba(255, 180, 0, 0.4);
        }
    }

    /* Brillo de Holograma de Cortana */
    @@keyframes cortanaText {
        0%, 100% {
            text-shadow: 0 0 10px #00f0ff, 0 0 20px rgba(0, 240, 255, 0.6);
            color: #ffffff;
        }

        50% {
            text-shadow: 0 0 18px #00f0ff, 0 0 35px #00a8ff;
            color: #e2f1f8;
        }
    }

    /* --- CONTENEDOR: DOSSIER TÁCTICO UNSC --- */
    .unsc-dossier {
        max-width: 1100px;
        margin: 50px auto;
        padding: 50px;
        background: rgba(13, 18, 25, 0.95);
        border: 2px solid #00f0ff;
        border-top: 10px solid #ffb400; /* Color Escudo Spartan */
        position: relative;
        clip-path: polygon(0 3%, 3% 0, 97% 0, 100% 3%, 100% 97%, 97% 100%, 3% 100%, 0 97%);
        box-shadow: 0 0 80px rgba(0, 240, 255, 0.25);
        animation: spartanBoot 0.8s ease-out forwards, hudPulse 6s infinite ease-in-out;
        backdrop-filter: blur(10px);
    }

    /* CABECERA MILITAR UNSC */
    .dossier-header {
        border-bottom: 2px dashed #00f0ff;
        padding-bottom: 20px;
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .dossier-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 2.8rem;
        color: #00f0ff;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 6px;
        animation: cortanaText 4s infinite;
    }

    /* SCANNER DE EQUIPAMIENTO / IMAGEN */
    .img-hud-container {
        position: relative;
        overflow: hidden;
        border: 2px solid #00f0ff;
        background: #05080c;
        box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
    }

    .img-hud {
        width: 100%;
        filter: contrast(1.1) brightness(0.9);
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .img-hud-container:hover .img-hud {
        filter: contrast(1.2) brightness(1.1) hue-rotate(15deg);
        transform: scale(1.05);
    }

    /* SECCIONES DE DATOS TÁCTICOS */
    .data-item-unsc {
        background: rgba(20, 30, 42, 0.7);
        padding: 18px 22px;
        border-left: 5px solid #3e4d30; /* Verde MJOLNIR */
        border-right: 1px solid rgba(0, 240, 255, 0.2);
        margin-bottom: 20px;
        transition: all 0.2s ease;
    }

        .data-item-unsc:hover {
            background: #3e4d30;
            border-left-color: #ffb400;
            transform: translateX(10px);
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.3);
        }

            .data-item-unsc:hover .label-unsc, .data-item-unsc:hover .value-unsc {
                color: #ffffff !important;
                text-shadow: 0 0 8px #00f0ff;
            }

    .label-unsc {
        font-family: 'Share Tech Mono', monospace;
        font-size: 0.85rem;
        color: #ffb400;
        text-transform: uppercase;
        display: block;
        letter-spacing: 2px;
    }

    .value-unsc {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.35rem;
        color: #ffffff;
        font-weight: 900;
    }

    /* CUADRO DE INFORME DE CORTANA */
    .cortana-report-box {
        margin-top: 30px;
        padding: 35px;
        background: rgba(5, 10, 16, 0.85);
        border: 1px solid #00f0ff;
        position: relative;
        box-shadow: inset 0 0 25px rgba(0, 240, 255, 0.15);
    }

        .cortana-report-box::before {
            content: "ANÁLISIS_TÁCTICO_DE_CORTANA";
            position: absolute;
            top: -14px;
            left: 25px;
            background: #00f0ff;
            color: #0b0e14;
            padding: 2px 18px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            font-weight: 900;
            letter-spacing: 2px;
        }

    .report-text {
        margin: 0;
        line-height: 1.9;
        color: #e2f1f8;
        font-family: 'Share Tech Mono', monospace;
        font-size: 1.05rem;
    }

    /* BOTONES TÁCTICOS */
    .btn-unsc-nav {
        display: inline-block;
        padding: 15px 45px;
        background: #3e4d30;
        color: #00f0ff;
        border: 2px solid #00f0ff;
        text-decoration: none !important;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1rem;
        letter-spacing: 4px;
        transition: all 0.25s ease;
        clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
    }

        .btn-unsc-nav:hover {
            background: #00f0ff;
            color: #0b0e14;
            box-shadow: 0 0 40px #00f0ff;
            transform: scale(1.06);
        }

    /* LÍNEAS DE ESCANEO HUD */
    .hud-scanlines {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(rgba(0, 240, 255, 0.02) 50%, rgba(0, 0, 0, 0.2) 50%);
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 50;
    }
</style>

<div class="unsc-dossier">
    <div class="hud-scanlines"></div>

    <div class="row">
        <!-- COLUMNA IMAGEN (SCANNER TÁCTICO) -->
        <div class="col-md-5 text-center mb-5">
            <div class="img-hud-container">
                <img src="@Model.ImagenUrl" class="img-hud" alt="@Model.Titulo" />
            </div>
            <div style="margin-top: 18px; font-family: 'Share Tech Mono', monospace; color: #ffb400; font-size: 0.85rem; letter-spacing: 2px;">
                REGISTRO TÁCTICO // INSTALACIÓN 04
            </div>
        </div>

        <!-- COLUMNA DATOS (ESPECIFICACIONES DE EQUIPAMIENTO) -->
        <div class="col-md-7">
            <div class="dossier-header">
                <h1 class="dossier-title">@Model.Titulo</h1>
                <span style="font-family: 'Share Tech Mono', monospace; color: #ffb400; font-size: 1.1rem;">UNSC_ID:#@Model.Id</span>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="data-item-unsc">
                        <span class="label-unsc">AÑO DE FABRICACIÓN</span>
                        <span class="value-unsc">@Model.Ano</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="data-item-unsc">
                        <span class="label-unsc">HORAS EN SERVICIO</span>
                        <span class="value-unsc">@Model.HorasDedicadas H.</span>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="data-item-unsc">
                        <span class="label-unsc">FECHA DE ASIGNACIÓN UNSC</span>
                        <span class="value-unsc">@Model.FechaAdquisicion.ToString("dd / MM / yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="cortana-report-box">
                <p class="report-text">
                    @Model.Descripcion
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model.VinculacionProyecto))
            {
                <div class="data-item-unsc mt-4" style="border-left-color: #00f0ff;">
                    <span class="label-unsc"> PROTOCOLO DE MISIÓN</span>
                    <span class="value-unsc" style="font-size: 1.1rem; color: #00f0ff;">@Model.VinculacionProyecto</span>
                </div>
            }
        </div>
    </div>

    <!-- BOTONES DE ACCIÓN -->
    <div style="display: flex; justify-content: center; border-top: 1px dashed rgba(0, 240, 255, 0.4); margin-top: 40px; padding-top: 30px;">
        <a asp-action="Index" class="btn-unsc-nav">
            REGRESAR AL MANDO TÁCTICO
        </a>
    </div>
</div>

<script>
    // Pulso telemétrico del visor MJOLNIR
    setInterval(() => {
        if (Math.random() > 0.92) {
            const dossier = document.querySelector('.unsc-dossier');
            dossier.style.boxShadow = "0 0 100px rgba(0, 240, 255, 0.6)";
            setTimeout(() => {
                dossier.style.boxShadow = "";
            }, 100);
        }
    }, 1500);
</script>

