<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameNexus: Scarecrow Edition</title>
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Orbitron:wght@700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* --- ESTÉTICA DE PESADILLA NEÓN --- */
            body {
                background-color: #000 !important;
                color: #ffcc00;
                font-family: 'Rajdhani', sans-serif;
                margin: 0;
                overflow-x: hidden;
                /* Rejilla de energía naranja */
                background-image: linear-gradient(rgba(255, 69, 0, 0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 69, 0, 0.15) 1px, transparent 1px);
                background-size: 50px 50px;
            }

                /* Viñeta de Gas del Miedo */
                body::after {
                    content: "";
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    box-shadow: inset 0 0 150px #000, inset 0 0 100px rgba(255, 69, 0, 0.2);
                    pointer-events: none;
                    z-index: 9999;
                    animation: gasPulse 4s infinite alternate;
                }

            /* --- ANIMACIONES --- */
            @@keyframes gasPulse {
                0% {
                    opacity: 0.5;
                }

                100% {
                    opacity: 1;
                    box-shadow: inset 0 0 200px #000, inset 0 0 150px rgba(255, 69, 0, 0.4);
                }
            }

            @@keyframes navGlitch {
                0%, 100% {
                    text-shadow: 0 0 5px #ff4500;
                }

                50% {
                    text-shadow: -3px 0 #ff0000, 3px 0 #ffcc00;
                    transform: skewX(-5deg);
                }
            }

            /* --- NAVBAR HACKEADA --- */
            .navbar {
                background: rgba(10, 0, 0, 0.95) !important;
                border-bottom: 3px solid #ff4500 !important;
                box-shadow: 0 0 30px #ff4500;
                padding: 15px 0;
            }

            .navbar-brand {
                font-family: 'Orbitron', sans-serif;
                font-weight: 900;
                color: #fff !important;
                letter-spacing: 5px;
                text-shadow: 0 0 15px #ff4500;
            }

            .nav-link {
                font-family: 'Special Elite', cursive;
                color: #ffcc00 !important;
                text-transform: uppercase;
                margin: 0 15px;
                transition: 0.2s;
                animation: navGlitch 3s infinite;
            }

                .nav-link:hover {
                    color: #fff !important;
                    transform: scale(1.2);
                    filter: drop-shadow(0 0 10px #ff4500);
                }

            .main-render {
                position: relative;
                z-index: 10;
            }

            footer {
                border-top: 1px solid #4a0000;
                background: #000;
                color: #8b0000;
                font-family: 'Special Elite', cursive;
                padding: 20px 0;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-3">
            <div class="container-fluid px-5">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">INICIO</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="GameNexus" asp-action="Index">[ ARCHIVOS_INFECTADOS ]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">[ PROTOCOLO_MIEDO ]</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 main-render">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center">
        <div class="container">
            <span>© @DateTime.Now.Year - EL MIEDO ES TU ÚNICA VERDAD</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Efecto de parpadeo de sistema aleatorio
        setInterval(() => {
        if(Math.random() > 0.95) {
        document.body.style.filter = "invert(1) contrast(3)";
        setTimeout(() => document.body.style.filter = "none", 50);
        }
        }, 2000);
    </script>
</body>
</html>