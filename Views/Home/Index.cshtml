@{
    <div class="scarecrow-welcome">
        <div class="toxin-emitter">
            <div class="biohazard-neon">☢</div>
            <div class="pulse-ring"></div>
        </div>

        <h1 class="master-title">BIENVENIDO CREADOR DYLAN MOSQUEDA</h1>
        <p class="fear-subtitle">EL GAS HA SIDO LIBERADO. LOS ARCHIVOS SEAN INFECTADO.</p>

        <div class="mt-5">
            <a href="/GameNexus/Index" class="btn-toxin-glow">
                ENTRAR AL CATALAGO INFECTADO
            </a>
        </div>
    </div>

    <style>
        .scarecrow-welcome {
            height: 75vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .toxin-emitter {
            position: relative;
            margin-bottom: 50px;
        }

        .biohazard-neon {
            font-size: 12rem;
            color: #ff4500; /* Naranja-Rojo tóxico */
            text-shadow: 0 0 30px #ff4500, 0 0 60px #ff0000;
            animation: rotateBio 10s infinite linear;
        }

        .pulse-ring {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100px;
            height: 100px;
            border: 5px solid #ffcc00;
            border-radius: 50%;
            animation: ringExpand 2s infinite ease-out;
        }

        .master-title {
            font-family: 'Orbitron';
            font-weight: 900;
            font-size: 3.5rem;
            color: #ffcc00; /* Amarillo Tóxico (Más llamativo y terrorífico) */
            text-align: center;
            text-shadow: 3px 3px 0 #8b0000, -3px -3px 0 #ff4500; /* Sombras rojo sangre y naranja */
            animation: textShake 0.1s infinite alternate;
        }

        .fear-subtitle {
            font-family: 'Special Elite', cursive;
            color: #ff4500; /* Naranja Fuego */
            font-size: 1.5rem;
            text-align: center;
            letter-spacing: 5px;
            text-shadow: 0 0 15px rgba(255, 69, 0, 0.6);
            font-weight: bold;
        }

        .btn-toxin-glow {
            padding: 25px 80px;
            background: #ff4500;
            color: #000; /* Texto negro para contraste agresivo */
            font-family: 'Orbitron';
            font-weight: 900;
            text-decoration: none;
            font-size: 1.2rem;
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
            box-shadow: 0 0 40px #ff4500;
            transition: 0.3s;
        }

            .btn-toxin-glow:hover {
                background: #fff;
                color: #ff4500; /* Cambio de color al pasar el mouse */
                box-shadow: 0 0 80px #fff;
                transform: scale(1.1) rotate(-2deg);
            }

        @@keyframes rotateBio {
            from {
                transform: rotate(0);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes ringExpand {
            0% {
                width: 0;
                height: 0;
                opacity: 1;
            }

            100% {
                width: 400px;
                height: 400px;
                opacity: 0;
            }
        }

        @@keyframes textShake {
            0% {
                transform: translate(1px, 1px);
            }

            100% {
                transform: translate(-1px, -1px);
            }
        }
    </style>
}