@{
    <div class="unsc-welcome">
        <!-- Emblema de Escudo Spartan y Sensor de Energía -->
        <div class="shield-emitter">
            <div class="unsc-emblem">🛡️</div>
            <div class="shield-ring"></div>
        </div>

        <h1 class="spartan-title">BIENVENIDO, SPARTAN DYLAN</h1>
        <p class="cortana-subtitle">SISTEMA MJOLNIR MARK V ONLINE. CORTANA EN LÍNEA.</p>

        <div class="mt-5">
            <a href="/GameNexus/Index" class="btn-spartan-glow">
                ACCEDER A LA BASE DE DATOS UNSC
            </a>
        </div>
    </div>

    <style>
        .unsc-welcome {
            height: 75vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .shield-emitter {
            position: relative;
            margin-bottom: 40px;
        }

        .unsc-emblem {
            font-size: 9rem;
            color: #00f0ff; /* Azul Neón Cortana / Visor */
            text-shadow: 0 0 30px #00f0ff, 0 0 60px rgba(0, 240, 255, 0.6);
            animation: pulseEmblem 3s infinite ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .shield-ring {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100px;
            height: 100px;
            border: 4px solid #ffb400; /* Dorado Escudo de Energía Halo 1 */
            border-radius: 50%;
            animation: shieldExpand 2.5s infinite ease-out;
        }

        .spartan-title {
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 3.2rem;
            color: #ffffff;
            text-align: center;
            letter-spacing: 4px;
            text-shadow: 0 0 20px #00f0ff, 3px 3px 0 #3e4d30; /* Brillo cian y sombra verde Spartan */
            animation: cortanaFlicker 4s infinite;
        }

        .cortana-subtitle {
            font-family: 'Share Tech Mono', 'Consolas', monospace;
            color: #ffb400; /* Amarillo/Dorado Alerta UNSC */
            font-size: 1.3rem;
            text-align: center;
            letter-spacing: 4px;
            text-shadow: 0 0 12px rgba(255, 180, 0, 0.6);
            font-weight: bold;
            margin-top: 10px;
        }

        .btn-spartan-glow {
            padding: 22px 70px;
            background: #3e4d30; /* Verde Oliva Armadura MJOLNIR */
            color: #00f0ff; /* Texto Neón Cortana */
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            text-decoration: none;
            font-size: 1.2rem;
            letter-spacing: 3px;
            border: 2px solid #00f0ff;
            clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
            transition: all 0.3s ease-in-out;
            display: inline-block;
        }

            .btn-spartan-glow:hover {
                background: #00f0ff;
                color: #0b0e14; /* Cambio a negro militar al pasar el mouse */
                box-shadow: 0 0 60px #00f0ff, inset 0 0 15px #ffffff;
                transform: scale(1.08) translateY(-3deg);
                border-color: #ffffff;
            }

        @@keyframes pulseEmblem {
            0%, 100% {
                transform: scale(1);
                filter: drop-shadow(0 0 20px #00f0ff);
            }

            50% {
                transform: scale(1.05);
                filter: drop-shadow(0 0 40px #ffb400);
            }
        }

        @@keyframes shieldExpand {
            0% {
                width: 50px;
                height: 50px;
                opacity: 1;
                border-color: #ffb400;
            }

            100% {
                width: 350px;
                height: 350px;
                opacity: 0;
                border-color: #00f0ff;
            }
        }

        @@keyframes cortanaFlicker {
            0%, 100% {
                opacity: 1;
            }

            92% {
                opacity: 1;
            }

            93% {
                opacity: 0.4;
                transform: skewX(2deg);
            }

            94% {
                opacity: 1;
            }

            98% {
                opacity: 0.8;
            }
        }
    </style>
}