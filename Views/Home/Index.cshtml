@{
    <div class="scarecrow-home">
        <!-- Monitor de Toxina / Escáner de Miedo -->
        <div class="toxin-scanner-container">
            <div class="fear-overlay"></div>
            <div class="biohazard-ring"></div>
            <div class="biohazard-ring-inner"></div>

            <!-- Icono Biohazard (En lugar del Bat-logo) -->
            <div class="scarecrow-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L15 8H21L16.5 12L18 18L12 14.5L6 18L7.5 12L3 8H9L12 2Z" fill="#ff4500" fill-opacity="0.6" />
                    <circle cx="12" cy="12" r="3" stroke="#ff4500" stroke-width="2" />
                </svg>
            </div>
            <div class="gas-pulse"></div>
        </div>

        <div class="scarecrow-terminal-text">
            <span class="warning-text">SISTEMA INFECTADO // GAS NIVEL CRÍTICO</span>
            <h1 class="scarecrow-title-main">CREADOR DYLAN MOSQUEDA LUGO</h1>

            <div class="fear-status-box">
                <p class="typing-fear">[ INYECTANDO TOXINA DE PRUEBA... ]</p>
                <p class="typing-fear" style="animation-delay: 2.5s;">[ EL MIEDO ES LA ÚNICA VERDAD... ]</p>
            </div>

            <div class="mt-5">
                <a href="/GameNexus/Index" class="btn-scarecrow">
                    <span class="btn-glitch-text">ENTRAR A LOS ARCHIVOS INFECTADOS</span>
                    <span class="btn-subtext">PROTOCOLO GAME NEXUS HUB</span>
                </a>
            </div>
        </div>
    </div>

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Special+Elite&family=Orbitron:wght@900&family=Rajdhani:wght@700&display=swap');

        .scarecrow-home {
            height: 85vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle, rgba(139, 0, 0, 0.2) 0%, rgba(5, 4, 0, 1) 100%);
            overflow: hidden;
        }

        /* ESCÁNER DE TOXINA */
        .toxin-scanner-container {
            position: relative;
            width: 300px;
            height: 300px;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            filter: drop-shadow(0 0 15px rgba(255, 69, 0, 0.4));
        }

        /* Fondo de grano y suciedad */
        .fear-overlay {
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: url('https://www.transparenttextures.com/patterns/asfalt-light.png');
            opacity: 0.2;
            border-radius: 50%;
            border: 2px solid #4a0000;
        }

        .biohazard-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            border: 4px double #ff4500;
            border-radius: 50%;
            animation: rotateScarecrow 15s linear infinite;
            opacity: 0.5;
        }

        .biohazard-ring-inner {
            position: absolute;
            width: 80%;
            height: 80%;
            border: 1px dashed #ffcc00;
            border-radius: 50%;
            animation: pulseFear 1.5s ease-in-out infinite;
        }

        .scarecrow-icon {
            width: 100px;
            z-index: 2;
            animation: glitchFear 0.2s infinite alternate;
        }

        .gas-pulse {
            position: absolute;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255, 69, 0, 0.2) 0%, transparent 70%);
            animation: gasExpand 4s ease-out infinite;
        }

        /* TEXTO Y TIPOGRAFÍA */
        .scarecrow-title-main {
            font-family: 'Orbitron', sans-serif;
            color: #ff4500;
            font-weight: 900;
            font-size: 3rem;
            letter-spacing: 10px;
            text-shadow: 4px 4px 0px #3a0000;
            margin-top: 10px;
            animation: glitchFear 3s infinite;
        }

        .warning-text {
            font-family: 'Special Elite', cursive;
            color: #ffcc00;
            letter-spacing: 5px;
            font-weight: bold;
            font-size: 1.1rem;
            text-shadow: 0 0 10px rgba(255, 204, 0, 0.5);
        }

        .fear-status-box {
            height: 60px;
            margin-top: 20px;
            text-align: center;
        }

        .typing-fear {
            font-family: 'Special Elite', cursive;
            color: #d4a373;
            font-size: 1.1rem;
            margin: 0;
            overflow: hidden;
            white-space: nowrap;
            width: 0;
            animation: typingScarecrow 2s steps(40, end) forwards;
        }

        /* BOTÓN ESTILO SCARECROW (INYECTORA) */
        .btn-scarecrow {
            position: relative;
            display: inline-block;
            background: #4a0000;
            color: #ff4500;
            padding: 20px 60px;
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            text-decoration: none;
            border: 2px solid #ff4500;
            transition: 0.3s;
            clip-path: polygon(0 15%, 100% 0, 95% 100%, 5% 85%);
            box-shadow: 0 0 20px rgba(74, 0, 0, 0.8);
        }

            .btn-scarecrow:hover {
                background: #ff4500;
                color: #000;
                box-shadow: 0 0 40px #ff4500;
                transform: translateY(-5px) rotate(-1deg);
            }

        .btn-subtext {
            position: absolute;
            bottom: 2px;
            right: 20px;
            font-size: 0.5rem;
            color: rgba(255, 204, 0, 0.6);
        }

        /* ANIMACIONES */
        @@keyframes rotateScarecrow {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes pulseFear {
            0%, 100% {
                transform: scale(1);
                opacity: 0.2;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.5;
                border-color: #ff4500;
            }
        }

        @@keyframes gasExpand {
            0% {
                transform: scale(0.5);
                opacity: 1;
            }

            100% {
                transform: scale(2);
                opacity: 0;
            }
        }

        @@keyframes glitchFear {
            0% {
                transform: translate(0);
            }

            20% {
                transform: translate(-2px, 1px) skewX(5deg);
            }

            40% {
                transform: translate(2px, -1px) skewX(-5deg);
            }

            60% {
                opacity: 0.8;
            }

            100% {
                transform: translate(0);
            }
        }

        @@keyframes typingScarecrow {
            from {
                width: 0;
            }

            to {
                width: 100%;
            }
        }

        /* Responsivo */
        @@media (max-width: 768px) {
            .scarecrow-title-main {
                font-size: 1.8rem;
                letter-spacing: 4px;
            }

            .toxin-scanner-container {
                width: 220px;
                height: 220px;
            }
        }
    </style>
}